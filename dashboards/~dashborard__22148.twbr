      <aliases enabled='yes' />
      <column caption='Badge risque' datatype='string' name='[Calculation_2235525713846282]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [net_margin] &lt; -40 THEN &quot;Critique&quot;&#10;ELSEIF [net_margin] &lt; -25 THEN &quot;Élevé&quot;&#10;ELSE &quot;Moyen&quot;&#10;END' />
      </column>
      <column caption='Ratio marge/ retour' datatype='real' name='[Calculation_2235525977563154]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[net_margin_rate] / [return_risk_score]' />
      </column>
      <column caption='rang risque ' datatype='integer' name='[Calculation_2235525980061715]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK(SUM([net_margin_rate]), &apos;asc&apos;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
