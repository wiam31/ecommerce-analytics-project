    <worksheet name='Waterfall'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontname='Benton Sans Book' underline='true'>Waterfall</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='waterfall_margin_st4' name='federated.1mi41mz0vpf1zj17kfbci07bs95v' />
          </datasources>
          <datasource-dependencies datasource='federated.1mi41mz0vpf1zj17kfbci07bs95v'>
            <column caption='Taille gant' datatype='integer' name='[Calculation_2235525702295559]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='-SUM([valeur])' />
            </column>
            <column caption='couleur waterfall' datatype='string' name='[Calculation_2235525702426632]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [type] = &quot;total&quot; THEN &quot;Total&quot;&#10;   ELSEIF [valeur] &gt;= 0 THEN &quot;Positif&quot;&#10;   ELSE &quot;Négatif&quot;&#10;   END' />
            </column>
            <column-instance column='[valeur]' derivation='Sum' name='[cum:sum:valeur:qk]' pivot='key' type='quantitative'>
              <table-calc aggregation='Sum' ordering-type='Rows' type='CumTotal' />
            </column-instance>
            <column caption='Etape' datatype='string' name='[etape]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_2235525702426632]' derivation='None' name='[none:Calculation_2235525702426632:nk]' pivot='key' type='nominal' />
            <column-instance column='[etape]' derivation='None' name='[none:etape:nk]' pivot='key' type='nominal' />
            <column-instance column='[valeur]' derivation='None' name='[none:valeur:ok]' pivot='key' type='ordinal' />
            <column caption='Type' datatype='string' name='[type]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_2235525702295559]' derivation='User' name='[usr:Calculation_2235525702295559:qk]' pivot='key' type='quantitative' />
            <column caption='Valeur' datatype='integer' name='[valeur]' role='dimension' type='ordinal' />
          </datasource-dependencies>
          <manual-sort column='[federated.1mi41mz0vpf1zj17kfbci07bs95v].[none:etape:nk]' direction='ASC'>
            <dictionary>
              <bucket>&quot;Revenu estime&quot;</bucket>
              <bucket>&quot;Cout produit&quot;</bucket>
              <bucket>&quot;Remises&quot;</bucket>
              <bucket>&quot;Livraison&quot;</bucket>
              <bucket>&quot;Retours&quot;</bucket>
              <bucket>&quot;Marge nette&quot;</bucket>
            </dictionary>
          </manual-sort>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='label'>
            <format attr='text-format' field='[federated.1mi41mz0vpf1zj17kfbci07bs95v].[none:valeur:ok]' value='c&quot;£&quot;#,##0;-&quot;£&quot;#,##0' />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='GanttBar' />
            <encodings>
              <color column='[federated.1mi41mz0vpf1zj17kfbci07bs95v].[none:Calculation_2235525702426632:nk]' />
              <size column='[federated.1mi41mz0vpf1zj17kfbci07bs95v].[usr:Calculation_2235525702295559:qk]' />
              <text column='[federated.1mi41mz0vpf1zj17kfbci07bs95v].[none:valeur:ok]' />
