        <view>
          <datasources>
            <datasource caption='waterfall_margin_st4' name='federated.1mi41mz0vpf1zj17kfbci07bs95v' />
          </datasources>
          <datasource-dependencies datasource='federated.1mi41mz0vpf1zj17kfbci07bs95v'>
            <column caption='Taille waterfall' datatype='integer' name='[Calculation_0026949688979461]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [type] = &quot;absolute&quot; THEN [valeur] ELSE -[valeur] END' />
            </column>
            <column caption='Debut waterfall' datatype='integer' name='[Calculation_0026949712773126]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RUNNING_SUM(SUM([valeur])) - SUM([valeur])'>
                <table-calc ordering-type='Rows' />
