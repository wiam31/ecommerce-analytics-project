      <aliases enabled='yes' />
      <column caption='Marge nette totale ' datatype='real' name='[Calculation_2235525698588672]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([net_margin])' />
      </column>
      <column caption='Taux de marge nette %' datatype='real' name='[Calculation_2235525698953217]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([net_margin]) / SUM([estimated_revenue])' />
      </column>
      <column caption='Libellé tranche remise' datatype='string' name='[Calculation_2235525699297282]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [discount_pct] = 0 THEN &quot;① 0% - Prix plein&quot;&#10;ELSEIF [discount_pct] &lt;= 10 THEN &quot;② 1-10% - Légère&quot;&#10;ELSEIF [discount_pct] &lt;= 25 THEN &quot;③ 11-25% - Significatif&quot;&#10;ELSEIF [discount_pct] &lt;= 50 THEN &quot;④ 26-50% - Forte&quot;&#10;ELSE &quot;⑤ &gt;50% - Liquidation&quot;&#10;END' />
      </column>
      <column caption='couleur marge' datatype='string' name='[Calculation_2235525699383299]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [net_margin] &gt;= 0 THEN &quot;Positive&quot; ELSE &quot;Négative&quot; END' />
      </column>
      <column caption='Revenu estimé ' datatype='real' name='[Calculation_2235525699608580]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([estimated_revenue])' />
      </column>
      <column caption='Marge brute' datatype='real' name='[Calculation_2235525700714501]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([gross_margin])' />
      </column>
      <column caption='Impact remise ' datatype='real' name='[Calculation_2235525701365766]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([discount_impact])' />
      </column>
      <column caption='remise arrondie' datatype='real' name='[Calculation_2235525708394505]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND([discount_pct])' />
      </column>
      <column caption='Marge nette simulé' datatype='real' name='[Calculation_2235525807751181]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_2235525807976462] - [product_cost] &#10;- [Calculation_2235525807976462] * ([Parameters].[Paramètre 1 (copie)]/100)&#10;- [shipping_cost]&#10;- [Calculation_2235525807976462] * 0.0839' />
      </column>
      <column caption='Revenu simulé  par commande ' datatype='real' name='[Calculation_2235525807976462]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[product_cost] / (1 - [Parameters].[Paramètre 1 (copie)]/100)' />
      </column>
      <column caption='impact de remise simulé' datatype='real' name='[Calculation_2235525809541135]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_2235525807976462] * ([Parameters].[Paramètre 1 (copie)]/100)' />
      </column>
      <column caption='Marge nette simulée' datatype='real' name='[Calculation_2235525809741840]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_2235525807976462] - [product_cost] - [Calculation_2235525809541135] - [shipping_cost] - ([Calculation_2235525807976462] * 0.0839)' />
      </column>
      <column caption='Alerte' datatype='string' name='[Calculation_2235525810065425]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Paramètre 1 (copie)] &gt; 25 &#10;THEN &quot;⚠ Marge dégradée&quot; &#10;ELSE &quot;✓ Rentable&quot; &#10;END' />
      </column>
      <column caption='Prior purchases' datatype='integer' name='[Prior_purchases]' role='measure' type='quantitative' />
