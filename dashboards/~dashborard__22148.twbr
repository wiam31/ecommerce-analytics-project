    <worksheet name='Simulateur'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontname='Benton Sans Book' underline='true'>L&apos;impact de remise </run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='mart_promo_impact_eda1' name='federated.1ug6iwi15dkv1g16528v10c433lg' />
            <datasource caption='Paramètres' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Taux de remise simulé' datatype='real' name='[Paramètre 1 (copie)]' param-domain-type='range' role='measure' type='quantitative' value='5.0'>
              <calculation class='tableau' formula='5.0' />
              <range granularity='1.0' max='65.0' min='0.0' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1ug6iwi15dkv1g16528v10c433lg'>
            <column caption='Revenu simulé  par commande ' datatype='real' name='[Calculation_2235525807976462]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[product_cost] / (1 - [Parameters].[Paramètre 1 (copie)]/100)' />
            </column>
            <column caption='impact de remise simulé' datatype='real' name='[Calculation_2235525809541135]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_2235525807976462] * ([Parameters].[Paramètre 1 (copie)]/100)' />
            </column>
            <column caption='Marge nette simulée' datatype='real' name='[Calculation_2235525809741840]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_2235525807976462] - [product_cost] - [Calculation_2235525809541135] - [shipping_cost] - ([Calculation_2235525807976462] * 0.0839)' />
            </column>
            <column caption='Alerte' datatype='string' name='[Calculation_2235525810065425]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Paramètre 1 (copie)] &gt; 25 &#10;THEN &quot;⚠ Marge dégradée&quot; &#10;ELSE &quot;✓ Rentable&quot; &#10;END' />
            </column>
            <column-instance column='[Calculation_2235525809741840]' derivation='Avg' name='[avg:Calculation_2235525809741840:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_2235525810065425]' derivation='None' name='[none:Calculation_2235525810065425:nk]' pivot='key' type='nominal' />
            <column-instance column='[product_importance]' derivation='None' name='[none:product_importance:nk]' pivot='key' type='nominal' />
            <column-instance column='[shipment_mode]' derivation='None' name='[none:shipment_mode:nk]' pivot='key' type='nominal' />
            <column caption='Product Cost' datatype='integer' name='[product_cost]' role='measure' type='quantitative' />
            <column caption='Product Importance' datatype='string' name='[product_importance]' role='dimension' type='nominal' />
            <column caption='Shipment Mode' datatype='string' name='[shipment_mode]' role='dimension' type='nominal' />
            <column caption='Shipping Cost' datatype='real' datatype-customized='true' name='[shipping_cost]' role='dimension' type='ordinal' />
          </datasource-dependencies>
          <slices>
            <column>[federated.1ug6iwi15dkv1g16528v10c433lg].[none:product_importance:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='header'>
            <format attr='height-header' value='21' />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Bar' />
            <encodings>
              <color column='[federated.1ug6iwi15dkv1g16528v10c433lg].[none:Calculation_2235525810065425:nk]' />
              <text column='[federated.1ug6iwi15dkv1g16528v10c433lg].[avg:Calculation_2235525809741840:qk]' />
            </encodings>
            <style>
              <style-rule element='mark'>
                <format attr='mark-labels-cull' value='true' />
                <format attr='mark-labels-show' value='true' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>[federated.1ug6iwi15dkv1g16528v10c433lg].[avg:Calculation_2235525809741840:qk]</rows>
        <cols>[federated.1ug6iwi15dkv1g16528v10c433lg].[none:shipment_mode:nk]</cols>
      </table>
