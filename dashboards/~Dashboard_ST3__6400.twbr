          </datasources>
          <datasource-dependencies datasource='federated.1ca85yo1333f6m1aowomx0z4rc84'>
            <column caption='Stock Code' datatype='string' name='[StockCode]' role='dimension' type='nominal' />
            <column caption='Avg Unit Price' datatype='string' name='[avg_unit_price]' role='dimension' type='nominal' />
            <column caption='Bcg Quadrant' datatype='string' name='[bcg_quadrant]' role='dimension' type='nominal' />
            <column caption='Description' datatype='string' name='[description]' role='dimension' type='nominal' />
            <column caption='Estimated Gain 5Pct' datatype='string' name='[estimated_gain_5pct]' role='dimension' type='nominal' />
            <column-instance column='[StockCode]' derivation='None' name='[none:StockCode:nk]' pivot='key' type='nominal' />
            <column-instance column='[avg_unit_price]' derivation='None' name='[none:avg_unit_price:nk]' pivot='key' type='nominal' />
            <column-instance column='[bcg_quadrant]' derivation='None' name='[none:bcg_quadrant:nk]' pivot='key' type='nominal' />
