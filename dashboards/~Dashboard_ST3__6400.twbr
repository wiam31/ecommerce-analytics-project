          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1d8hsz21jn0sl817kvw8401zpvc8'>
            <column caption='Bcg Quadrant' datatype='string' name='[bcg_quadrant]' role='dimension' type='nominal' />
            <column-instance column='[bcg_quadrant]' derivation='None' name='[none:bcg_quadrant:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1ca85yo1333f6m1aowomx0z4rc84].[none:description:nk]'>
